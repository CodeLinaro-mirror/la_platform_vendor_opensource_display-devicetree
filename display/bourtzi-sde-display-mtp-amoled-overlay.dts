/dts-v1/;
/plugin/;

#include "bourtzi-sde-display-mtp-amoled.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. Bourtzi MTP";
	compatible = "qcom,bourtzi-mtp", "qcom,mtp", "qcom,bourtzi", "qcom,bourtzip";
	qcom,msm-id = <776 0x10000>, <777 0x10000>;
	qcom,board-id = <0x20008 0x0>, <0x10008 0x0>, <0x10008 0x600>;
};
