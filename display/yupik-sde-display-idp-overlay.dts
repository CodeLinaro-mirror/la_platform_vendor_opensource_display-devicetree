	qcom,msm-id = <475 0x10000>, <476 0x10000>, <537 0x10000>, <583 0x10000>, <613 0x10000>, <631 0x10000>, <633 0x10000>, <634 0x10000>, <638 0x10000>, <663 0x10000>;
	qcom,board-id = <34 0>, <34 1>, <34 2>, <34 3>, <34 4>, <34 5>, <34 6>, <34 0x600>, <34 0x601>, <34 0x602>, <34 0x603>, <34 0x604>;
};
