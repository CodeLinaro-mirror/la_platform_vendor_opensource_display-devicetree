#include "yupik-sde-display.dtsi"

/*==============================*/
/*     Display Related Start    */
/*==============================*/

&soc {
	vcc_3v3_lt9611: regulator-vcc-3v3-lt9611 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3_lt9611";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	vdd_1v2_lt9611: regulator-vdd-1v2-lt9611 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_1v2_lt9611";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
	};
};

&qupv3_se1_i2c {
	clock-frequency = <100000>;
	status = "okay";

	lt9611: lt,lt9611@2f {
		compatible = "lt,lt9611uxc";
		reg = <0x2f>;

		interrupt-names = "lt_irq";
		interrupts-extended = <&tlmm 61 0x0>;
		reset-gpios = <&tlmm 60 0>;
		enable-gpios = <&tlmm 62 0>;

		vdd-supply = <&vdd_1v2_lt9611>;
		vcc-supply = <&vcc_3v3_lt9611>;

		lt,reset-gpio-active-high;
		lt,preferred-mode = "3840x2160";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				lt9611_in: endpoint {
					remote-endpoint = <&ext_dsi_out>;
				};
			};
		};
	};
};

&dsi_ext_bridge_1080p {
	qcom,mdss-dsi-ext-bridge-hpd;
};

&dsi_ext_bridge_4k30p {
	qcom,mdss-dsi-ext-bridge-hpd;
	qcom,dsi-select-clocks = "pll_byte_clk0", "pll_dsi_clk0";
};

&sde_dsi {
	/delete-property/ lab-supply;
	/delete-property/ ibb-supply;

	qcom,dsi-default-panel = <&dsi_ext_bridge_4k30p>;
	boot-panel-param = "disabled";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			ext_dsi_out: endpoint {
				remote-endpoint = <&lt9611_in>;
			};
		};
	};
};

&fsa4480 {
	status = "disabled";
};

&sde_wb {
	status = "disabled";
};

&mdss_mdp {
	connectors = <&smmu_sde_unsec &smmu_sde_sec &sde_dsi &sde_rscc>;
};
